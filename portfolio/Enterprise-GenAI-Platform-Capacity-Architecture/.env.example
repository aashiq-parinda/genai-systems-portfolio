# ═══════════════════════════════════════════════════════════════════════════════
# Enterprise GenAI Platform — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Gateway ────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
GATEWAY_ENV=development           # development | staging | production
GATEWAY_DEBUG=false

# ── Inference Backend ──────────────────────────────────────────────────────────
# Set to "mock" to run without a GPU. Set to "vllm" for real inference.
INFERENCE_BACKEND=mock
VLLM_BASE_URL=http://mock-inference:8002
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_MAX_RETRIES=2

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gateway:gateway_secret@postgres:5432/gateway_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string-in-production
API_KEY_PREFIX=llm_
API_KEY_HASH_ITERATIONS=260000    # PBKDF2-SHA256 iterations

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Default plan limits (overridden by per-user quota in DB)
DEFAULT_RPM=10                    # requests per minute
DEFAULT_TPM=50000                 # tokens per minute
DEFAULT_DAILY_TOKENS=50000
DEFAULT_MONTHLY_TOKENS=1000000
DEFAULT_MAX_CONCURRENT=2

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
ENABLE_METRICS=true

# ── Enterprise Control Plane (existing service) ────────────────────────────────
ENTERPRISE_GATEWAY_URL=http://gateway:8000
