# ==============================================================================
# LangChain, LangGraph, LangSmith, & LangFlow Environment Configuration
# ==============================================================================

# Model Provider Credentials (Optional: Leave blank to use built-in Zero-Cost Mock Engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Execution Mode: Set to "true" for zero-cost offline simulation, "false" for live LLMs
USE_MOCK_LLM=true

# LangSmith Observability & Tracing (https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lang-ecosystem-fundamentals

# Official LangFlow Dashboard Host & Port
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
