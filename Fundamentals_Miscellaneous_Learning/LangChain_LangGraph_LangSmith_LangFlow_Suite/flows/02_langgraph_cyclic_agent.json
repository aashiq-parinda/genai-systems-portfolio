        "targetHandle": "plan_steps"
      },
      {
        "id": "e_tool_to_critic",
        "source": "agent_tool_executor",
        "target": "agent_critic",
        "sourceHandle": "observations",
        "targetHandle": "findings"
      },
      {
        "id": "e_critic_loop_to_tool",
        "source": "agent_critic",
        "target": "agent_tool_executor",
        "sourceHandle": "revision_request",
        "targetHandle": "revision_feedback"
      },
      {
        "id": "e_critic_to_gate",
        "source": "agent_critic",
        "target": "agent_human_gate",
        "sourceHandle": "approved_draft",
        "targetHandle": "draft"
      }
    ],
    "viewport": { "x": 0, "y": 0, "zoom": 1 }
