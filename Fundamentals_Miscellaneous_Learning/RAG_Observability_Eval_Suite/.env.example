# ==============================================================================
# RAG Observability & Eval Suite - Environment Configuration
# ==============================================================================

# Simulation Mode:
# When set to True, the pipeline executes offline without incurring API costs or requiring live servers.
SIMULATION_MODE=True

# LLM Provider Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
ANTHROPIC_API_KEY=

# Langfuse Configuration (Self-Hosted or Cloud)
LANGFUSE_PUBLIC_KEY=pk-lf-mock-public-key
LANGFUSE_SECRET_KEY=sk-lf-mock-secret-key
LANGFUSE_HOST=http://localhost:3000

# Arize Phoenix Configuration
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=cloudflow-customer-support-rag

# Helicone Configuration (Proxy Edge Layer)
HELICONE_API_KEY=sk-helicone-mock-key
HELICONE_BASE_URL=https://oai.helicone.ai/v1
