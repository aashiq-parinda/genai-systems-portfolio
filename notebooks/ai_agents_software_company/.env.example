# ==============================================================================
# Environment Configuration for AI Agents Software Company Project
# ==============================================================================
# The notebook runs seamlessly without external API keys using its built-in
# Deterministic Intelligent Mock Engine. If you wish to connect real frontier
# models, populate the relevant provider keys below:

# LLM Provider selection: "mock" (default), "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=mock

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Anthropic API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama Settings (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Execution Settings
LOG_LEVEL=INFO
MAX_AGENT_STEPS=8
HITL_AUTO_APPROVE=false
